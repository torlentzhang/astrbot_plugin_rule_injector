{
  "_profiles_v1": {
    "type": "bool",
    "description": "旧配置迁移标记",
    "hint": "内部标记，不要手改。",
    "invisible": true,
    "default": false
  },
  "profiles": {
    "type": "dict",
    "description": "按配置档案分组的规则数据",
    "hint": "每个配置档案有独立的规则、思维链与示例场景，请到插件详情页的「规则配置」页面编辑，这里是数据存储，不要手改。",
    "invisible": true,
    "default": {}
  },
  "rules": {
    "type": "list",
    "description": "规则列表",
    "hint": "规则请到插件详情页的「规则配置」页面编辑，这里是数据存储，不要手改。",
    "invisible": true,
    "default": [],
    "items": {
      "id": {
        "type": "str",
        "description": "标识",
        "default": ""
      },
      "name": {
        "type": "str",
        "description": "规则名称",
        "default": ""
      },
      "enabled": {
        "type": "bool",
        "description": "是否启用",
        "default": true
      },
      "scope": {
        "type": "str",
        "description": "生效范围",
        "default": "all"
      },
      "content": {
        "type": "text",
        "description": "规则内容",
        "default": ""
      }
    }
  },
  "thought_example": {
    "type": "object",
    "description": "少样本示例场景",
    "hint": "请到插件详情页的「自定义思维链」页面编辑，这里是数据存储，不要手改。user 是示例里用户说的话，reply 是示例里角色最终回复；留空时分别回退为「在吗」与「嗯？怎么了」。",
    "invisible": true,
    "default": {
      "user": "",
      "reply": ""
    },
    "items": {
      "user": {
        "type": "text",
        "description": "示例输入",
        "default": ""
      },
      "reply": {
        "type": "text",
        "description": "示例回复",
        "default": ""
      }
    }
  },
  "thought_chains": {
    "type": "list",
    "description": "思维链",
    "hint": "请到插件详情页的「思维链」页面编辑，这里是数据存储，不要手改。每条包含一个关键词和对应规则：关键词为「思维链」时，插件会在发送前剥掉 <思维链>…</思维链>，但保留在会话历史里，模型下一轮仍看得到自己想过什么。",
    "invisible": true,
    "default": [
      {
        "id": "default-thought",
        "name": "思维链",
        "keyword": "思维链",
        "enabled": true,
        "content": "写得比说话长、可以写自己的反应、可以在心里复述他的话、可以没头没尾。使用第一人称，别跳出来评价自己演得像不像。"
      }
    ],
    "items": {
      "id": {
        "type": "str",
        "description": "标识",
        "default": ""
      },
      "name": {
        "type": "str",
        "description": "名称",
        "default": ""
      },
      "keyword": {
        "type": "str",
        "description": "关键词",
        "default": ""
      },
      "enabled": {
        "type": "bool",
        "description": "是否启用",
        "default": true
      },
      "content": {
        "type": "text",
        "description": "规则内容",
        "default": ""
      },
      "example_thought": {
        "type": "text",
        "description": "示例念头（可选，给模型示范标签里放具体念头；留空则复用规则内容）",
        "default": ""
      }
    }
  }
}